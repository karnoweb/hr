{
    "name": "karnoweb/hr",
    "description": "A comprehensive HR management package for Laravel (Iranian context)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Karnoweb",
            "email": "info@karnoweb.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "morilog/jalali": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Karnoweb\\Hr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karnoweb\\Hr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karnoweb\\Hr\\HrServiceProvider"
            ],
            "aliases": {
                "Hr": "Karnoweb\\Hr\\Facades\\Hr"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
