{
    "name": "karnoweb/hr",
    "description": "A comprehensive HR management package for Laravel (Iranian context)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Karnoweb",
            "email": "info@karnoweb.com"
        }
    ],
    "version": "13.0.2",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "morilog/jalali": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Karnoweb\\Hr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karnoweb\\Hr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "pint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karnoweb\\Hr\\HrServiceProvider"
            ],
            "aliases": {
                "Hr": "Karnoweb\\Hr\\Facades\\Hr"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
